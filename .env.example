# sigma-forge example environment. Only the optional `sigma-forge draft` command
# reads these; lint, convert, fire-test, coverage, and the test suite need none.
#
# sigma-forge reads the process environment and does not load .env files itself.
# Load this file with your shell, for example: set -a; . ./.env; set +a
# Never commit a real .env (.gitignore and the gitleaks hook guard against it).

# OpenAI-compatible endpoint of your LOCAL model server (LM Studio, Ollama,
# llama.cpp, vLLM, ...). Non-loopback hosts are refused unless you pass
# --allow-remote, because the threat description is sent to the endpoint.
SIGMA_FORGE_LLM_BASE_URL=http://127.0.0.1:1234/v1

# Model name to request from the server.
SIGMA_FORGE_LLM_MODEL=local-model

# Optional bearer token. Local servers usually ignore it; leave it empty.
SIGMA_FORGE_LLM_API_KEY=
