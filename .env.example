# sigma-forge — example environment file.
# Copy to `.env` and fill in locally. NEVER commit a real .env (gitleaks + .gitignore guard this).
#
# The offline core (convert / evaluate / coverage / lint / tests) needs ZERO of these.
# They are ONLY used by the optional `sigma-forge draft` command.

# OpenAI-compatible endpoint for the local rule drafter.
# Defaults to LM Studio's local server. Point at Ollama, llama.cpp, vLLM, etc. as needed.
OPENAI_BASE_URL=http://localhost:1234/v1

# Optional. Local servers usually ignore this; set any non-empty value if your server requires one.
# Do NOT put a real cloud API key here for normal use — the drafter is local-first by design.
OPENAI_API_KEY=

# Optional: model name the drafter requests from the local server.
SIGMA_FORGE_DRAFT_MODEL=local-model
